# Supabase session pooler (IPv4, port 5432) with sslmode=require.
# Keep the password percent-encoded inside the URL.
DATABASE_URL=postgresql+psycopg2://postgres.PROJECT_REF:PERCENT_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# Application secrets. Never commit real values.
SECRET_KEY=replace-with-current-production-secret
ENCRYPTION_MASTER_KEY=replace-with-current-production-base64-key
# Preserve the existing identity key across deployments. The current production
# setup uses SECRET_KEY as this value.
KAIRON_IDENTITY_KEY=replace-with-current-production-secret

# Session and temporary-password policy.
SESSION_COOKIE_SECURE=true
TEMP_PASSWORD_EXPIRY_HOURS=72

# Current single-service deployment runs Celery tasks eagerly.
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=true

# Email remains suppressed until a production SMTP relay is configured.
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_USE_TLS=false
EMAIL_USE_SSL=false
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@vitalysehealth.local
EMAIL_SUPPRESS_SEND=true
EMAIL_VALIDATE_CONFIG=false

# Frontend and diagnostics.
FRONTEND_LOGIN_URL=https://hph.onrender.com/login
LOG_DECRYPTED_PAYLOADS=false
CORS_ALLOWED_ORIGINS=https://hph.onrender.com

# Gunicorn. Render supplies PORT automatically.
WEB_CONCURRENCY=1
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120
SUPABASE_IMPORT_BUCKET=hph-imports
SUPABASE_URL=https://ihdcxcleylmjthisbkwh.supabase.co

# Run imports inside the web service on Render Free.
IMPORT_EMBEDDED_PROCESSING=true
