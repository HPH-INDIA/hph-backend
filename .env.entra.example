# Merge with the existing backend environment. No frontend secrets are needed.
# Leave false until the application registration, credentials and links are ready.
ENTRA_ENABLED=false
# Optional pilot: comma-separated company-tenant user object IDs; empty permits normal group access.
ENTRA_PILOT_OBJECT_IDS=
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
PUBLIC_APP_ORIGIN=https://digital-cockpit.archpocs.in
# Generate a dedicated Fernet key; keep it stable across all web workers.
ENTRA_TRANSACTION_KEY=
# Production: mount the private key from secret storage and upload its public certificate to Entra.
ENTRA_PRIVATE_KEY_FILE=
ENTRA_CERT_THUMBPRINT=
# Alternative for local/staging: a server-side application client secret.
ENTRA_CLIENT_SECRET=
SESSION_COOKIE_SECURE=true
CSRF_ENABLED=true
