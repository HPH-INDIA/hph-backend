# Linux server overrides. Copy to .env.compose and replace the example IP.
# Run: docker compose --env-file .env.compose up --build -d
# Secrets and Supabase connection stay in hph-backend/.env.render.
FRONTEND_BIND_ADDRESS=0.0.0.0
FRONTEND_PORT=8080
# The full stack proxies requests internally; direct backend access stays local.
# Set BACKEND_BIND_ADDRESS=0.0.0.0 only if direct LAN API access is needed.
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=8081
SESSION_COOKIE_SECURE=false
FRONTEND_LOGIN_URL=http://192.168.1.100:8080/login
CORS_ALLOWED_ORIGINS=http://192.168.1.100:8080
