# Private Docker test environment. Copy to .env.test; never commit real values.
# Copy the Session pooler URL from the TEST Supabase project's Connect dialog.
# Use port 5432 and sslmode=require. Percent-encode the database password.
DATABASE_URL=postgresql+psycopg2://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_STORAGE_SECRET_KEY=replace-with-test-project-secret-or-service-role-key
SUPABASE_IMPORT_BUCKET=hph-test-imports
IMPORT_MAX_FILE_BYTES=50000000

# Generate these once for a NEW test database and keep them stable.
# If reusing an existing database, use its EXISTING keys unchanged.
SECRET_KEY=replace-with-random-application-secret
ENCRYPTION_MASTER_KEY=replace-with-base64-encoded-32-byte-key
KAIRON_IDENTITY_KEY=replace-with-random-identity-secret

WEB_CONCURRENCY=1
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120
TEMP_PASSWORD_EXPIRY_HOURS=72

# Dockerfile.test runs jobs eagerly; no Redis or local Postgres is needed.
# Test email delivery stays suppressed by default.
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_USE_TLS=false
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=noreply@hph-test.local
